# ──────────────────────────────────────────────────────────────
#  Lumière Events — Environment Variables
#  Copy this file to `.env.local` and fill in real values.
# ──────────────────────────────────────────────────────────────

# Public site URL (used for SEO canonical tags, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── MongoDB ───────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/event-planner
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/event-planner
MONGODB_URI=mongodb://127.0.0.1:27017/event-planner

# ── Admin dashboard credentials ───────────────────────────────
# Use a real email and a strong, unique password in production.
ADMIN_EMAIL=admin@lumiere-events.com
ADMIN_PASSWORD=use-a-strong-unique-password
# Secret that signs the admin session token. REQUIRED in production
# (the app refuses to start admin sessions without it). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-string

# ── Email notifications (SMTP) ────────────────────────────────
# If these are left blank the app still works — submissions are saved
# and the email step is skipped with a console notice (great for local dev).
# For Gmail use an App Password (https://myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Where new-inquiry notifications are sent (defaults to ADMIN_EMAIL)
NOTIFICATION_EMAIL=
# "From" address shown on outgoing mail
EMAIL_FROM="Lumière Events <hello@lumiere-events.com>"

# ── Cloudinary (Media Library / Portfolio uploads) ────────────
# Create a free account at cloudinary.com → Dashboard shows these values.
# Cloud name + API key are public (used by the browser upload widget);
# the API secret stays server-side and signs uploads.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
